# Copy to .env and fill in. Never commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# Local model (Ollama on your 5080). Start Ollama, then: ollama pull qwen2.5:7b-instruct
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_MODEL=qwen2.5:7b-instruct

CLAUDE_MODEL=claude-haiku-4-5

POSTGRES_DSN=postgresql://ada:ada_dev@localhost:5432/ada
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Bind localhost only — Ada can run commands on your machine (see ARCHITECTURE.md).
HOST=127.0.0.1
PORT=8000
